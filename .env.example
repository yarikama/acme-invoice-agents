# replay | openrouter | xai | offline
#   replay:     no key. The agents answer from a recorded live run of the
#               sample invoices (data/replay/recording.json): the real agent
#               conversation, tool calls and costs, with validation and the
#               payment policy running for real.
#   openrouter: live Grok (and other vendors' models) through OpenRouter.
#   xai:        live Grok through xAI directly.
#   offline:    no key, rule-based agents; can't read TXT or PDF invoices.
LLM_PROVIDER=replay
XAI_API_KEY=
OPENROUTER_API_KEY=

# Models: extraction is cheap and fast, review reasons harder.
EXTRACT_MODEL=grok-4.3
REVIEW_MODEL=grok-4.7

APPROVAL_THRESHOLD=10000

# Optional System 1 triage: a decision model on OpenRouter's Decisions API
# reads each invoice first and settles the clear-cut ones without the
# reasoning approver. Needs OPENROUTER_API_KEY, whatever LLM_PROVIDER is.
# TRIAGE_MODEL=perplexity/pplx-decider-flash-v1.2

# Record the agents' answers on a live run, for replay:
# RECORD_TO=data/replay/recording.json
